[Unit]
Description=Kaspire KRON unsigned test transaction planner
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/kaspire/source/services/dex-test
ExecStart=/opt/node-v22.23.1/bin/node /srv/kaspire/source/services/dex-test/server.mjs
User=www-data
Group=www-data
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp
MemoryMax=768M
TasksMax=64

[Install]
WantedBy=multi-user.target
