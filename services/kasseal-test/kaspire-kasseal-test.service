[Unit]
Description=Kaspire Kasseal unsigned TN10 planner
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/kaspire/source/services/kasseal-test
ExecStart=/opt/node-v22.23.1/bin/node /srv/kaspire/source/services/kasseal-test/server.mjs
User=www-data
Group=www-data
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=512M
TasksMax=48

[Install]
WantedBy=multi-user.target
