// Kaspire experimental vault. Compile with official Silverscript v1.0.0.
// DAA score is authoritative. Time estimates are UI hints only.
pragma silverscript ^0.1.0;
contract KaspireTimeLock(byte[32] owner, int unlockDaa, byte[32] instance) {
    byte[32] identity = instance;
    entry release(sig approval) {
        require(identity.length == 32);
        require(this.activeInputIndex == 0);
        require(tx.inputs.length == 1);
        require(tx.outputs.length == 1);
        byte[32] id = OpInputCovenantId(0);
        require(OpCovInputCount(id) == 1);
        require(OpCovOutputCount(id) == 0);
        require(approval.length == 65);
        require(byte[1](approval.slice(64, 65)) == byte[1](0x01));
        require(checkSig(approval, pubkey(owner)));
        require(tx.daa >= unlockDaa);
        byte[36] ownerScript = new ScriptPubKeyP2PK(pubkey(owner));
        require(tx.outputs[0].scriptPubKey == byte[](ownerScript));
    }
}
